{
  "name": "claude-transcript-parser",
  "version": "1.0.0",
  "description": "Standalone TypeScript parser for JSONL transcript files produced by the Claude Agent SDK",
  "main": "dist/transcript-parser.js",
  "types": "dist/transcript-parser.d.ts",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint lib tests --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "anthropic",
    "agent-sdk",
    "transcript",
    "parser",
    "jsonl",
    "session",
    "database",
    "sync"
  ],
  "author": "Anthropic Community",
  "license": "MIT",
  "files": [
    "dist",
    "lib",
    "README.md"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
